<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>hum.api</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/me/Library/Application Support/hum/hum</string>
		<string>run</string>
		<string>api</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/me/Library/Logs/hum/api.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/me/Library/Logs/hum/api.log</string>
</dict>
</plist>
